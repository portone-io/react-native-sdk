{
  "name": "@portone/react-native-sdk",
  "version": "0.6.0",
  "description": "PortOne SDK for React Native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./plugin": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "del-cli lib",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "PortOne",
    "payment",
    "포트원",
    "결제 연동"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portone-io/react-native-sdk.git"
  },
  "author": "portone <tech.support@portone-io> (https://github.com/portone-io)",
  "contributors": [
    "kiwiyou <kiwiyou@portone.io> (https://github.com/kiwiyou)"
  ],
  "license": "(Apache-2.0 OR MIT)",
  "bugs": {
    "url": "https://github.com/portone-io/react-native-sdk/issues"
  },
  "homepage": "https://github.com/portone-io/react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/config-conventional": "^21.0.1",
    "@evilmartians/lefthook": "^2.1.6",
    "@expo/config-plugins": "^55.0.9",
    "@react-native/typescript-config": "0.83.6",
    "@types/jest": "^30.0.0",
    "@types/react": "catalog:",
    "commitlint": "^21.0.1",
    "del-cli": "^7.0.0",
    "jest": "^30.4.2",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "^0.41.0",
    "react-native-webview": "^13.16.1",
    "typescript": "catalog:"
  },
  "resolutions": {
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "@portone/browser-sdk": "*",
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "version": "0.41.0"
  }
}

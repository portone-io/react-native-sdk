{
  "name": "@portone/react-native-sdk",
  "version": "0.7.0",
  "description": "PortOne SDK for React Native",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./plugin": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "PortOne",
    "payment",
    "포트원",
    "결제 연동"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portone-io/react-native-sdk.git"
  },
  "author": "portone <tech.support@portone-io> (https://github.com/portone-io)",
  "contributors": [
    "kiwiyou <kiwiyou@portone.io> (https://github.com/kiwiyou)"
  ],
  "license": "(Apache-2.0 OR MIT)",
  "bugs": {
    "url": "https://github.com/portone-io/react-native-sdk/issues"
  },
  "homepage": "https://github.com/portone-io/react-native-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/config-conventional": "^21.0.1",
    "@evilmartians/lefthook": "^2.1.6",
    "@expo/config-plugins": "~58.0.12",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "catalog:",
    "commitlint": "^21.0.1",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "^0.41.0",
    "react-native-webview": "14.0.1",
    "typescript": "catalog:"
  },
  "resolutions": {
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "@portone/browser-sdk": "*",
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "version": "0.41.0"
  }
}
